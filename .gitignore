crashlytics-build.properties

# macOS
.DS_Store

# ---------------------------------------------------------------- project
# Hand-rolled backups of source files. Git is the reason these can go:
# every one of them is a previous state of a file that is now in history.
# 146 files / 6.2 MB as of the first commit.
*.bak
*.bak.meta

# Screenshots already staged for deletion (44 MB of PNGs). The device bridge
# cannot delete files, so they were moved here instead of removed.
Assets/**/.to_delete/

# NOT ignored, deliberately: Assets/Phase1/qa_*.txt and friends. Those are the
# measurement files the tuning decisions rest on - the engine ladder, the
# cascade probe, the damage sweeps - and the design docs cite them by name.

# Scratch copies made by earlier zip-delivery sessions. Each holds an OUT OF
# DATE duplicate of the real scripts (BuilderManager.cs was 2049-2196 lines in
# these; the live file is 4018), so committing them would put four editable
# stale copies of the main source file in the repo. Same reason *.bak is
# ignored: git is what these folders were standing in for.
Assets/Phase1/.bundle*/

# GitHub token, pasted by owen, read by the shell as $(cat .gh_token.local) and
# never printed. MUST stay ignored: every folder this session can reach lives
# inside this repository, so an un-ignored secret here would be one `git add -A`
# away from being pushed to a remote.
.gh_token.local

# scratch used to defeat the stale-file cache in device_stage_files
Assets/Phase1/.push_tmp/

# ---- 2026-08-05: kept out of the repo, with the measurement that decided it --
# The Xcode build output. 1.1 GB, entirely regenerated by a Unity build, and
# far past what belongs in source control.
ios/

# QA screenshots. 175 MB of PNGs captured by the probes; they are evidence for
# a session, not project content, and the sessions that need them write fresh
# ones. The qa_*.txt REPORTS beside them stay tracked (279 of them already are)
# because those are small, diffable, and get quoted in handovers.
Assets/Phase1/qa_shots/

# The bridge to this machine cannot delete files - rm fails with "Operation not
# permitted" - so anything that needs removing gets moved here instead and the
# owner empties it by hand. Never content.
_to_delete/
