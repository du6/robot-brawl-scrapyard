<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.400" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SQL ships beside the binary: Infra.cs loads these files at boot,
         and tests/sql_bench.sh proves the same text. Copying rather than
         embedding keeps them readable in a running container. -->
    <None Include="Sql\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Migrations\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
